# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=all-MiniLM-L6-v2

# TypeSafe AI (Jev System One for Composite Scoring)
# Get your free key at https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Summarizer Configuration ("gemini", "groq", "ollama", or "auto")
SUMMARIZER_PROVIDER=auto

# Google AI Studio (Gemini Flash - Generous Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (Llama 3.1 Fast Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Local (e.g., qwen2.5:1.5b or phi3:mini for 1-2GB VRAM / CPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Ingest Interval & Frontend
INGEST_INTERVAL_MINUTES=60
FRONTEND_ORIGIN=http://localhost:8000

# TypeSafe model (see client.models.list())
TYPESAFE_MODEL=jev-latest

# Polymarket (read-only, public Gamma API: no key needed)
POLYMARKET_ENABLED=true
POLYMARKET_SYNC_LIMIT=200
POLYMARKET_MIN_VOLUME=10000
MARKET_MATCH_THRESHOLD=0.55
MARKET_NEWS_WINDOW_HOURS=72
MARKET_MAX_ARTICLES=8

# Forecasting signals (Jev vs market price)
PREDICTION_AUTO=false
PREDICTION_MAX_PER_RUN=10
MODEL_WEIGHT_MAX=0.5
MIN_EDGE=0.05
MIN_EVIDENCE=0.5
KELLY_FRACTION=0.25
