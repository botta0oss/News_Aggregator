# Database Configuration
# Without Docker: full connection string. With docker compose it is built from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
# Docker compose: database password, set BEFORE the first start (letters and digits only,
# e.g. the output of: openssl rand -hex 24)
POSTGRES_PASSWORD=change_me

# Docker compose on a server: extra services to start
#   tunnel = Cloudflare Tunnel (HTTPS on your domain, no open ports), backup = daily database dump
# COMPOSE_PROFILES=tunnel,backup
# Token of the tunnel created on Cloudflare (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# Days of daily backups kept in ./backups
BACKUP_KEEP_DAYS=14
# Address the app port 8000 listens on: 127.0.0.1 = this machine only (default, safe behind the
# tunnel); 0.0.0.0 = reachable from the network (home LAN: also SESSION_COOKIE_SECURE=false)
API_BIND=127.0.0.1
# Language of the texts written in the background: Telegram alerts, news summaries, stored notes
# ("en" or "it"). The dashboard has its own IT/EN button and sends its choice with every request.
APP_LANGUAGE=en

SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# TypeSafe AI (Jev System One for Composite Scoring)
# Get your free key at https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Summarizer Configuration ("gemini", "groq", "ollama", or "auto")
SUMMARIZER_PROVIDER=auto

# Google AI Studio (Gemini Flash - Generous Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (e.g. llama-3.1-8b-instant, or openai/gpt-oss-20b: reasoning is kept short automatically)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Local (e.g., qwen2.5:1.5b or phi3:mini for 1-2GB VRAM / CPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Ingest Interval & Server
INGEST_INTERVAL_MINUTES=60
AI_BATCH_SIZE=25
FEED_TIMEOUT_SECONDS=20
FEED_MAX_BYTES=5000000
# Feeds on internal addresses are refused (SSRF protection); enable only if you need one
ALLOW_PRIVATE_FEEDS=false
# Extra origins allowed to call the API with cookies (the dashboard itself needs none)
CORS_ORIGINS=
# Disable /docs and /openapi.json in production
API_DOCS_ENABLED=true

# Dashboard access (users are managed with: python -m backend.auth.cli --help)
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=720
# auto = Secure cookie except on localhost. Set false only to open the dashboard over plain
# HTTP from another device on your home network (with API_BIND=0.0.0.0)
SESSION_COOKIE_SECURE=auto
# Behind Cloudflare Tunnel set it to CF-Connecting-IP: the real visitor IP for the login limits
CLIENT_IP_HEADER=
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Optional: creates this admin at first startup if no user exists. Remove the password afterwards.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# TypeSafe model (see client.models.list())
TYPESAFE_MODEL=jev-latest

# Polymarket (read-only, public Gamma API: no key needed)
POLYMARKET_ENABLED=true
POLYMARKET_SYNC_LIMIT=200
POLYMARKET_MIN_VOLUME=10000
# Multi-outcome events (elections, tournaments...): how many to sync, outcomes passed to Jev
MULTI_SYNC_LIMIT=60
MULTI_MAX_OUTCOMES=12
# Minimum match score news <-> market: semantic similarity + key terms (0-1)
MARKET_MATCH_THRESHOLD=0.5
MARKET_NEWS_WINDOW_HOURS=168
MARKET_MAX_ARTICLES=8
EVIDENCE_HALF_LIFE_HOURS=48

# Targeted news search per market (Google News RSS, no key needed)
TARGETED_NEWS_ENABLED=true
TARGETED_NEWS_MAX_MARKETS=25
TARGETED_NEWS_REFRESH_HOURS=6

# Forecasting signals (Jev vs market price)
PREDICTION_AUTO=false
PREDICTION_MAX_PER_RUN=10
# Jev's maximum weight against the price, and how far from the price (log-odds) before it shrinks
MODEL_WEIGHT_MAX=0.25
MODEL_DISAGREEMENT_LOGIT=2.0
# A forecast is valid for buying for this many hours, and while the price moves less than this (log-odds)
FORECAST_MAX_AGE_HOURS=6
FORECAST_MAX_PRICE_MOVE=0.5
# Markets decided by an asset's price (e.g. "Bitcoin above $84,000 on September 24"): no bets, no paid forecasts
EXCLUDE_PRICE_MARKETS=true
MIN_EDGE=0.05
MIN_EVIDENCE=0.5
# Second opinion from a free model (Gemini, then Groq): buy only if it is on the same side of the price as Jev
SECOND_OPINION_ENABLED=true
SECOND_OPINION_PROVIDERS=gemini,groq
SECOND_OPINION_MARGIN=0
SECOND_OPINION_REQUIRED=false
# Evidence from the facts: weighted news total worth 0.5; the lower of this and Jev's rating is used (0 = Jev only)
EVIDENCE_OBJECTIVE_HALF=1.5
KELLY_FRACTION=0.25

# Betting economics & simulated portfolio
POLYMARKET_CLOB_URL=https://clob.polymarket.com
RISK_FREE_RATE=0.04
# Taker fee rate (bps, applied to p × (1 − p)) for categories without a known rate
DEFAULT_FEE_BPS=500
DEFAULT_SPREAD=0.02
MODEL_PSEUDO_COUNT=20
PAPER_BANKROLL=1000
PAPER_PRESET=bilanciato
# Automatic buys: maker limit orders one tick above the bid (no fee, may not fill) or taker (take the ask)
PAPER_ORDER_MODE=maker
MAKER_ORDER_TTL_HOURS=6
MAKER_TICK=0.01
# No buys of shares under this price (long shots win less often than their price says)
LONGSHOT_MIN_PRICE=0.10
# Closing-line guard: pause automatic bets (or exclude a category) when the price keeps moving against them
CLV_GUARD_ENABLED=true
CLV_GUARD_WINDOW=15
CLV_GUARD_MIN_BETS=8
CLV_GUARD_CATEGORY_MIN_BETS=5
CLV_GUARD_MIN_AVG=-0.02
CLV_GUARD_MIN_AGE_HOURS=1

# Client-side rate limits for AI providers: set them to your plan's limits
GROQ_RPM=20
GEMINI_RPM=10
JEV_RPM=30
JEV_CONCURRENCY=2
OLLAMA_CONCURRENCY=1
AI_MAX_WAIT_SECONDS=90

# News-vs-price alerts (thresholds are edited in the dashboard, page Allerte)
ALERT_SCAN_MINUTES=10
ALERT_TIMEZONE=Europe/Rome
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dashboard address, used for the link in the notifications
PUBLIC_URL=

# Paid AI calls: daily limits (0 = none) and prices in USD per million tokens, to estimate
# the cost. All editable from the dashboard (Uso e costi).
DAILY_JEV_CALL_LIMIT=0
DAILY_AI_BUDGET_USD=0
JEV_PRICE_PER_CALL=0
JEV_PRICE_INPUT_MTOK=0
JEV_PRICE_OUTPUT_MTOK=0
GROQ_PRICE_INPUT_MTOK=0
GROQ_PRICE_OUTPUT_MTOK=0
GEMINI_PRICE_INPUT_MTOK=0
GEMINI_PRICE_OUTPUT_MTOK=0
