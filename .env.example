# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres
SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=all-MiniLM-L6-v2

# TypeSafe AI (Jev System One for Composite Scoring)
# Get your free key at https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Summarizer Configuration ("gemini", "groq", "ollama", or "auto")
SUMMARIZER_PROVIDER=auto

# Google AI Studio (Gemini Flash - Generous Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (Llama 3.1 Fast Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Local (e.g., qwen2.5:1.5b or phi3:mini for 1-2GB VRAM / CPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Ingest Interval & Server
INGEST_INTERVAL_MINUTES=60
AI_BATCH_SIZE=100
FEED_TIMEOUT_SECONDS=20
FEED_MAX_BYTES=5000000
# Feeds on internal addresses are refused (SSRF protection); enable only if you need one
ALLOW_PRIVATE_FEEDS=false
# Extra origins allowed to call the API with cookies (the dashboard itself needs none)
CORS_ORIGINS=
# Disable /docs and /openapi.json in production
API_DOCS_ENABLED=true

# Dashboard access (users are managed with: python -m backend.auth.cli --help)
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=720
SESSION_COOKIE_SECURE=auto
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Optional: creates this admin at first startup if no user exists. Remove the password afterwards.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# TypeSafe model (see client.models.list())
TYPESAFE_MODEL=jev-latest

# Polymarket (read-only, public Gamma API: no key needed)
POLYMARKET_ENABLED=true
POLYMARKET_SYNC_LIMIT=200
POLYMARKET_MIN_VOLUME=10000
MARKET_MATCH_THRESHOLD=0.55
MARKET_NEWS_WINDOW_HOURS=72
MARKET_MAX_ARTICLES=8

# Forecasting signals (Jev vs market price)
PREDICTION_AUTO=false
PREDICTION_MAX_PER_RUN=10
MODEL_WEIGHT_MAX=0.5
MIN_EDGE=0.05
MIN_EVIDENCE=0.5
KELLY_FRACTION=0.25
